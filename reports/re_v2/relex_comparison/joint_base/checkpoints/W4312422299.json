      "relation_type": "CHANGES",
      "confidence": 0.7934826612472534,
      "suspicious_type_hint": false,
      "evidence": [
        {
          "window_id": "w:ec1b112260589ff9754a876bdd4d8717a90df550484c3c22de46db0782c6c7d3",
          "document_id": "W4312422299",
          "start": 0,
          "end": 617,
          "text": "The Book of Mormon presents a tale of the plight and flight of a family from biblical Jerusalem, stitched together through a variety of narrators. As the title page claims, this book contains the record of the Nephite people, descendants of Lehi, who was commanded by God to leave Jerusalem in order to save his family from destruction. From that command, the text becomes one of movement and escape, so that the Nephite race can avoid destruction. As this story is one about avoiding annihilation, it necessarily becomes one of reproduction: How do the Nephites reproduce the people of God to spread the word of God?",
          "entity_ids": []
        }
      ]
    },
