      "head_id": "e:6ba6c52dd15c39316dcc955719af6a27c3cfac09ed895d66a7eeca2bfab44f18",
      "tail_id": "e:a8438fe731392c7f76a05bcb0512808a75b9bdfed9875079c7aa7f3a8e01a349",
      "head_types": [
        "CONCEPT",
