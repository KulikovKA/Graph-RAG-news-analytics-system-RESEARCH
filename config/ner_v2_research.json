    "E2": {"source": "large", "window_words": 110, "overlap_words": 25, "labels": "short"},
    "E3": {"source": "gliner25", "window_words": 110, "overlap_words": 25, "labels": "short"},
    "E4": {"source": "large", "window_words": 110, "overlap_words": 25, "labels": "broad_exploratory"}
