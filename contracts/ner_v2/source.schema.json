{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "NER v2 scientific source",
  "required": [
    "contract_version",
    "document_id",
    "text",
    "text_sha256",
    "title",
    "year",
    "discipline",
    "field",
    "source_url",
    "source_reference"
  ],
  "properties": {
    "contract_version": {
      "const": "ner-v2-source-1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3000
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "discipline": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "display_name"
      ]
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "source_reference": {
      "type": "object",
      "required": [
        "source_url",
        "text_sha256"
      ]
    }
  }
}
