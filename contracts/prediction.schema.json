{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C-001 graph predictions",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "document_code",
    "document_id",
    "revision_id",
    "split",
    "chunks",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "cgraph-v1"
    },
    "mode": {
      "enum": [
        "end_to_end",
        "gold_entities_re_diagnostic"
      ]
    },
    "document_code": {
      "enum": [
        "D001",
        "D003",
        "D004",
        "D010",
        "D017",
        "D024",
        "D026",
        "D035",
        "D038",
        "D060",
        "D078",
        "D092"
      ]
    },
    "document_id": {
      "type": "string"
    },
    "revision_id": {
      "type": "string"
    },
    "split": {
      "const": "DEV"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "wall_ms",
        "cpu_ms",
        "llm_calls"
      ],
      "properties": {
        "wall_ms": {
          "type": "number",
          "minimum": 0
        },
        "cpu_ms": {
          "type": "number",
          "minimum": 0
        },
        "llm_calls": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "span_id",
        "document_id",
        "revision_id",
        "chunk_id",
        "start",
        "end",
        "text",
        "source_text_sha256"
      ],
      "properties": {
        "span_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "mention_id",
        "start",
        "end",
        "surface_text",
        "kind",
        "contextual_role",
        "source_spans"
      ],
      "properties": {
        "mention_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "surface_text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "MATERIAL",
            "DEVICE",
            "PROPERTY",
            "PERFORMANCE",
            "ANALYTE",
            "PROCESS",
            "MECHANISM",
            "OPERATING_CONDITION",
            "MORPHOLOGY",
            "TECHNOLOGY",
            "APPLICATION",
            "OTHER"
          ]
        },
        "contextual_role": {
          "type": "string"
        },
        "source_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": [
        "assertion_id",
        "head_mention_id",
        "tail_mention_id",
        "relation_type",
        "polarity",
        "modality",
        "qualifiers",
        "evidence",
        "decision_status",
        "qualifier_status"
      ],
      "properties": {
        "assertion_id": {
          "type": "string"
        },
        "head_mention_id": {
          "type": "string"
        },
        "tail_mention_id": {
          "type": "string"
        },
        "relation_type": {
          "enum": [
            "HAS_PROPERTY",
            "HAS_PERFORMANCE",
            "HAS_MORPHOLOGY",
            "HAS_COMPONENT",
            "HAS_MEMBER",
            "USES_MATERIAL",
            "FUNCTIONS_AS",
            "DETECTS",
            "USED_FOR",
            "FABRICATED_BY",
            "IMPROVES",
            "ACTS_ON",
            "INTEGRATED_IN",
            "HAS_MECHANISM",
            "MECHANISM_INVOLVES",
            "LOCATED_IN",
            "OPTIMIZES",
            "FACILITATES",
            "CAUSES",
            "EXPLAINS",
            "CHANGES_PARAMETER",
            "DEPENDS_ON",
            "MEETS_REQUIREMENT"
          ]
        },
        "polarity": {
          "enum": [
            "POSITIVE",
            "NEGATIVE"
          ]
        },
        "modality": {
          "enum": [
            "ASSERTED",
            "PROPOSED",
            "HYPOTHETICAL",
            "COMPARED"
          ]
        },
        "qualifier_status": {
          "enum": [
            "UNKNOWN",
            "EXPLICIT",
            "NOT_APPLICABLE",
            "UNSUPPORTED_CAPABILITY"
          ]
        },
        "qualifiers": {
          "type": "array"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "decision_status": {
          "const": "ACCEPTED_PROVISIONAL"
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": [
        "chunk_id",
        "source_text_sha256",
        "entities",
        "candidate_pairs",
        "raw_proposals",
        "assertions",
        "stage_ms"
      ],
      "properties": {
        "chunk_id": {
          "type": "string"
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "candidate_pairs": {
          "type": "array"
        },
        "raw_proposals": {
          "type": "array"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "stage_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "end_to_end"
          }
        }
      },
      "then": {
        "required": [
          "concepts",
          "identity_decisions",
          "architecture_id",
          "extraction_status"
        ]
      }
    }
  ]
}
